# Variables para `docker compose`. Copia este archivo a `.env` (en la raíz
# del proyecto, junto a docker-compose.yml) y complétalo. `.env` no se sube
# al repositorio: todas las contraseñas y claves viven solo ahí.

# OBLIGATORIA. Contraseña de la base de datos PostgreSQL que crea Docker en
# esta computadora (no es la de producción). Inventa una cualquiera, sin
# espacios. Se aplica al crear la base por primera vez: si la cambias
# después, hay que recrear la base con `docker compose down -v`.
POSTGRES_DOCKER_PASSWORD=

# Puerto local del sistema (http://localhost:8080). Cámbialo si 8080 está ocupado.
FRONTEND_PORT=8080

# Opcional. Asistente con Claude real (sin esto funciona en modo demostración):
LLM_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Opcional: si se define, el chat pide este código para usar Claude real
# (sin él responde en modo demostración). Vacío = no se pide código.
ASISTENTE_CODIGO_ACCESO=
