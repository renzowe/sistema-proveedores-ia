# Variables opcionales para `docker compose`. Copia este archivo a `.env`
# (en la raíz del proyecto, junto a docker-compose.yml). `.env` no se sube
# al repositorio.

# Asistente con Claude real (sin esto funciona en modo demostración):
LLM_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Opcional: si se define, el chat pide este código para usar Claude real
# (sin él responde en modo demostración). Vacío = no se pide código.
ASISTENTE_CODIGO_ACCESO=

# Puerto local del sistema (http://localhost:8080). Cámbialo si 8080 está ocupado.
FRONTEND_PORT=8080

# Contraseña de la base de datos local del contenedor.
POSTGRES_PASSWORD=proveedores_local
