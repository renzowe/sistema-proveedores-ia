DATABASE_URL=postgresql+psycopg2://postgres:TU_PASSWORD@localhost:5432/sistema-proveedores-ia
PORT=8000
HOST=127.0.0.1
# Capa de IA (Fase 11 — preparación arquitectónica; integración real en Fase 12).
# LLM_ENABLED=false hace que el sistema opere en modo 100% determinístico.
LLM_ENABLED=false
# API Key de Anthropic. Se obtiene en https://console.anthropic.com/ y NUNCA debe
# subirse al repositorio. Dejar vacía mientras LLM_ENABLED=false.
ANTHROPIC_API_KEY=
# Modelo de Claude a utilizar cuando la integración real se active en la Fase 12.
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=1024
CLAUDE_TEMPERATURE=0.2
