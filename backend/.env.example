DATABASE_URL=postgresql+psycopg2://postgres:TU_PASSWORD@localhost:5432/sistema-proveedores-ia
PORT=8000
HOST=127.0.0.1
# Dominios del frontend autorizados a llamar a la API desde el navegador,
# separados por comas y sin barra final. Sin valor, solo se aceptan
# http://localhost:5500 y http://127.0.0.1:5500 (desarrollo local).
# En producción (Render), la URL pública del frontend:
# CORS_ORIGINS=https://sistema-proveedores-ia-1.onrender.com
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Límites del asistente conversacional (endpoint público que consume la API Key):
# mensajes por IP en la ventana indicada, y mensajes totales por día (UTC).
ASISTENTE_LIMITE_POR_IP=20
ASISTENTE_VENTANA_SEGUNDOS=600
ASISTENTE_LIMITE_DIARIO=200
# Código de acceso al asistente con Claude real. Si se define, el chat lo pide
# (botón "Usar Claude"); sin el código correcto responde en modo demostración y
# no consume la API Key. Vacío = no se pide (solo para desarrollo local).
# EN PRODUCCIÓN debe definirse ANTES de activar LLM_ENABLED=true. Usar solo
# letras, números y guiones (va en una cabecera HTTP), 12 caracteres o más.
ASISTENTE_CODIGO_ACCESO=
# Intentos con un código incorrecto permitidos por IP en la ventana anterior.
ASISTENTE_INTENTOS_CODIGO=5
# Capa de IA — integración real con Claude vía API de Anthropic.
# LLM_ENABLED=false hace que el sistema opere en modo 100% determinístico.
LLM_ENABLED=false
# API Key de Anthropic. Se obtiene en https://console.anthropic.com/ y NUNCA
# debe subirse al repositorio. Dejar vacía mientras LLM_ENABLED=false.
ANTHROPIC_API_KEY=
# Modelo de Claude a utilizar.
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=1024
